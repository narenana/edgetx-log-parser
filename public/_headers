# Cloudflare Pages reads this file on deploy and applies the headers to
# matching responses. First match wins.
#
# We rely on Vite's content-hashed bundle filenames for cache busting:
# every JS/CSS chunk lives at a URL like /assets/index-Bgtt1Ers.js where
# the suffix is a hash of the file contents. Changing a file always
# produces a new URL, so the old URL is permanent — safe to mark
# `immutable` and cache for a year. The HTML, which references those
# hashes, stays on the Pages default (`max-age=0, must-revalidate`)
# so users always pick up the latest hash references after a deploy.

# Vite-emitted hashed bundles + chunks + CSS.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cesium runtime — not content-hashed (vite-plugin-cesium copies the
# library verbatim into /cesium/). Filenames are stable across our
# builds, so a long-ish cache is fine; bump or purge manually after a
# Cesium version upgrade.
/cesium/*
  Cache-Control: public, max-age=604800

# Sample logs the demo button loads. Regenerated by scripts/gen-sample-log.js
# occasionally — keep the cache short so demo refreshes pick up changes.
/sample-*.csv
  Cache-Control: public, max-age=3600
